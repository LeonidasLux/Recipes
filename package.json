{
  "name": "jishiben",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "记食本 — 菜谱收藏 + 点单，数据存在你自己的 GitHub 仓库里",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "esbuild scripts/smoke.tsx --bundle --platform=node --format=esm --target=node20 --loader:.css=empty --external:react --external:react-dom --external:react-dom/client --external:react-router-dom --external:jsdom --outfile=.tmp/smoke.mjs --log-level=warning && node --import ./scripts/register-dom.mjs .tmp/smoke.mjs",
    "icons": "node scripts/make-icons.mjs",
    "classes": "node scripts/check-classes.mjs",
    "test:live": "esbuild scripts/live-github-test.ts --bundle --platform=node --format=esm --target=node20 --outfile=.tmp/live.mjs --log-level=warning && node .tmp/live.mjs",
    "test:connect": "esbuild scripts/live-connect-test.tsx --bundle --platform=node --format=esm --target=node20 --loader:.css=empty --external:react --external:react-dom --external:react-dom/client --external:react-router-dom --external:jsdom --outfile=.tmp/live-connect.mjs --log-level=warning && node --import ./scripts/register-dom.mjs .tmp/live-connect.mjs",
    "check": "npm run typecheck && npm run classes && npm run smoke && npm run build",
    "apk": "node scripts/set-version.mjs && npm run icons && npm run build && npx cap sync android && cd android && gradlew assembleDebug",
    "apk:release": "node scripts/set-version.mjs && npm run icons && npm run build && npx cap sync android && cd android && gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
